cabal-version: 3.0
name:          jsonlogic-consumer
version:       0.1.0.0
synopsis:      A downstream user of jsonlogic-hs, to check the package can be adopted
description:
  Depends on jsonlogic-hs the way a user would and imports only the public
  JsonLogic module. scripts/consumer-smoke.sh builds it against the source
  distribution. It is not part of the package and is never published.
license:       MIT
build-type:    Simple

executable jsonlogic-consumer
  default-language: Haskell2010
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -Wall
  build-depends:    base         >=4.18 && <4.23
                  , aeson        >=2.1  && <2.4
                  , bytestring   >=0.11 && <0.13
                  , jsonlogic-hs
